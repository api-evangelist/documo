  "info": {
    "_postman_id": "106710eb-0a5b-4aaf-9e55-18116ae72a2a",
    "name": "Documo Account Numbers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Documo (mFax) cloud fax and document delivery platform. The API is organized around REST, accepts form-encoded and JSON request bodies, returns JSON-encoded responses, and is secured with an API key passed in the Authorization header. Send and receive faxes, manage fax numbers, subscribe to delivery events via webhooks, and read account information.\n\nContact Support:\n Name: Documo Support",
      "type": "text/plain"
    }
  }
