{
  "opencollection": "1.0.0",
  "info": {
    "name": "Documo Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.documo.com/v1/account"
          },
          "docs": "Retrieves the authenticated account's profile and settings."
        }
      ]
    }
  ],
  "bundled": true
}